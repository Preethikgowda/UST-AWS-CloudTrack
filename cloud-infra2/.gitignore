# Environment
.env
.env.prod
.env.local
.env.*.local
*.env

# Credentials and keys
*.pem
*.key
*.crt
*.p12
*.pfx
id_rsa
id_ed25519
.aws/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
.eggs/
venv/
.venv/
env/

# Node
node_modules/
frontend/node_modules/
frontend/dist/
frontend/build/
.npm
.yarn

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Docker
docker/data/

# Logs
*.log
logs/
*.pid

# Coverage
htmlcov/
.coverage
.coverage.*
coverage/
.nyc_output/

# Testing
.pytest_cache/
.mypy_cache/

# Local generated artifacts
*.bak
*.tmp
tmp/

# Terraform generated files
**/.terraform/
